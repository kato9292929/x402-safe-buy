# Keys for the MCP server (x402-safe-buy-mcp) and scripts/try.ts. Never commit real values.
# Base: 0x-prefixed 32-byte hex private key
SAFE_BUY_EVM_PRIVATE_KEY=
# Solana: 64-byte secret key, base58 or JSON array
SAFE_BUY_SOLANA_SECRET_KEY=

# Optional
# Ceiling on any maxPrice passed to the MCP safe_buy tool (USD, default 0.10)
SAFE_BUY_MAX_PRICE_CAP=0.10
# Probe base URL (default https://probe.x402jp.com)
SAFE_BUY_PROBE_URL=
# RPC endpoints for the on-chain search (defaults: public mainnet endpoints)
BASE_RPC_URL=
SOLANA_RPC_URL=
